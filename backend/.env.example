# Port the Express API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API.
# In production, set this to your deployed frontend URL only — never "*".
CORS_ORIGIN=http://localhost:3000

# How long (ms) each upstream response is cached before we refetch.
# Protects the free upstream APIs from being hammered and keeps the UI snappy.
CACHE_TTL_MS=600000
